#!/bin/sh
# Restore the conventional Nokia XG Ethernet layout on first boot.
# PPPoE credentials are intentionally left unset for the owner to enter.

. /lib/functions/system.sh

case "$(board_name)" in
	nokia,xg-040g-md|nokia,xg-040g-md-ubi|nokia,xg-040g-tf|nokia,xg-040g-tf-ubi|\
	nokia,xg-140g-md|nokia,xg-140g-md-ubi|nokia,xg-140g-tf|nokia,xg-140g-tf-ubi)
		;;
	*)
		exit 0
		;;
esac

# Locate the bridge generated by board.d.  It is normally an anonymous
# `device` section, so it must be addressed through its UCI index.
bridge_section=
index=0
while uci -q get "network.@device[$index]" >/dev/null; do
	if [ "$(uci -q get "network.@device[$index].name")" = "br-lan" ]; then
		bridge_section="@device[$index]"
		break
	fi
	index=$((index + 1))
done

if [ -z "$bridge_section" ]; then
	bridge_section="$(uci -q add network device)" || exit 1
	uci -q set "network.$bridge_section.name=br-lan"
fi

uci -q set "network.$bridge_section.type=bridge"
uci -q delete "network.$bridge_section.ports" || true
uci -q add_list "network.$bridge_section.ports=lan1"
uci -q add_list "network.$bridge_section.ports=lan2"
uci -q add_list "network.$bridge_section.ports=lan3"

uci -q set network.lan='interface'
uci -q set network.lan.device='br-lan'
uci -q set network.lan.proto='static'

uci -q set network.wan='interface'
uci -q set network.wan.device='lan4'
uci -q set network.wan.proto='pppoe'
uci -q delete network.wan.username || true
uci -q delete network.wan.password || true

# Keep IPv6 tied to the PPP interface rather than the removed PON device.
uci -q set network.wan6='interface'
uci -q set network.wan6.device='@wan'
uci -q set network.wan6.proto='dhcpv6'

uci -q commit network

exit 0
